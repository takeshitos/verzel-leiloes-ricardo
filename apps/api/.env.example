# Copie este arquivo para apps/api/.env e ajuste os valores.
# O arquivo .env não vai para o git. Não coloque segredos neste exemplo.

# Ambiente: development, test ou production.
NODE_ENV=development

# Porta HTTP da API. Em desenvolvimento o proxy do Vite espera a porta 3000.
PORT=3000

# Endereço de escuta. Padrão: 127.0.0.1 em desenvolvimento e 0.0.0.0 em produção.
# HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Banco de dados. Escolha UMA das opções.
# Se a senha tiver caracteres especiais (@ : / # % etc.), use a forma codificada
# para URL (ex.: @ vira %40). Os bancos locais são criados automaticamente pelo
# npm run db:migrate se ainda não existirem.
# ---------------------------------------------------------------------------

# Opção A: PostgreSQL já instalado na máquina (porta 5432). Troque USUARIO e SENHA.
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/verzel_dev
TEST_DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/verzel_test

# Opção B: Docker Compose (docker compose up -d). Credenciais só de desenvolvimento.
# DATABASE_URL=postgres://verzel:verzel_dev_only@localhost:5433/verzel_dev
# TEST_DATABASE_URL=postgres://verzel:verzel_dev_only@localhost:5433/verzel_test

# Máximo de conexões do pool (padrão 10).
# DATABASE_POOL_MAX=10

# Senha das contas fictícias criadas pelo seed (padrão documentado no README).
# SEED_DEMO_PASSWORD=leilao-demo-2026

# Em produção o Render liga estas opções; localmente use os comandos db:migrate e db:seed.
# RUN_MIGRATIONS_ON_START=false
# RUN_SEED_ON_START=false

# ---------------------------------------------------------------------------
# Auditoria (docs/AUDITORIA.md)
# ---------------------------------------------------------------------------
# Chave privada Ed25519 (base64). Gere com: npm run audit:keygen -w apps/api
# Use uma chave só sua para desenvolvimento; a de produção fica só no painel do Render.
AUDIT_SIGNING_PRIVATE_KEY=COLE_AQUI_A_CHAVE_GERADA
AUDIT_KEY_VERSION=1
# Âncora independente (outro banco). Os bancos locais são criados pelo db:migrate:anchor.
ANCHOR_DATABASE_URL=postgres://verzel:verzel_dev_only@localhost:5433/verzel_anchor
TEST_ANCHOR_DATABASE_URL=postgres://verzel:verzel_dev_only@localhost:5433/verzel_anchor_test

# Intervalo do job de encerramento automático (padrão 5000 ms). Também roda no startup.
# SETTLEMENT_INTERVAL_MS=5000

# Proxy confiável e cabeçalho com o IP do cliente (só em produção, no Render).
# TRUST_PROXY=0
# CLIENT_IP_HEADER=cf-connecting-ip
