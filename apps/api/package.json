{
  "name": "@verzel/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test": "tsx src/db/migrate.ts --test",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:test": "tsx src/db/seed.ts --test",
    "db:demo-lot": "tsx src/db/demo-lot.ts",
    "db:migration:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "db:migrate:anchor": "tsx src/db/migrate.ts --anchor",
    "db:migrate:anchor:test": "tsx src/db/migrate.ts --anchor --test",
    "audit:keygen": "tsx src/modules/audit/keygen.ts",
    "audit:check": "tsx src/modules/audit/check.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
